---
const { title, subtitle } = Astro.props;
// Optional named slot: rendered on the same row as the title (e.g. an external
// link badge). When nothing is passed, the title keeps its original markup so
// the layout is byte-for-byte what it was before the slot existed.
const hasAside = Astro.slots.has("aside");
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1"></span>
    <span class="education__line bg-primary block h-full w-[2px] translate-x-[7px]"></span>
  </div>
  <div class="experience__data bd-grid px-5">
    {hasAside ? (
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-1">
        <h3 class="text-primary" style="font-weight:700;font-size:1.05rem;">{title}</h3>
        <span class="shrink-0"><slot name="aside" /></span>
      </div>
    ) : (
      <h3 class="text-primary mb-1" style="font-weight:700;font-size:1.05rem;">{title}</h3>
    )}
    <span class="font-light text-sm text-base-content/75">{subtitle}</span>
    <p class="my-2 text-justify text-base-content/85 whitespace-pre-line">
      <slot />
    </p>
  </div>
</div>
