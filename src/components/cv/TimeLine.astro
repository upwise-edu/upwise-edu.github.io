---
const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1"></span>
    <span class="education__line bg-primary block h-full w-[2px] translate-x-[7px]"></span>
  </div>
  <div class="experience__data bd-grid px-5">
    <h3 class="text-primary mb-1" style="font-weight:700;font-size:1.05rem;">{title}</h3>
    <span class="font-light text-sm text-base-content/75">{subtitle}</span>
    <p class="my-2 text-justify text-base-content/85 whitespace-pre-line">
      <slot />
    </p>
  </div>
</div>
