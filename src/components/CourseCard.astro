---
import type { Course } from '../data/courses';
import { formatDuration } from '../data/courses';

interface Props {
  course: Course;
}

const { course } = Astro.props as Props;
---

<a
  href={course.url}
  target="_blank"
  rel="noopener noreferrer"
  class="course-card group block py-5 px-4 -mx-4 rounded-lg transition-all duration-300 hover:bg-base-200/60"
>
  <!-- Top row: title + free badge -->
  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="text-lg md:text-xl font-bold text-base-content group-hover:text-primary transition-colors duration-200 leading-snug">
      {course.title}
      <span class="inline-block ml-1 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all">↗</span>
    </h3>
    {course.isFree && (
      <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-md font-mono text-xs font-bold bg-primary text-white shadow-sm">
        FREE
      </span>
    )}
  </div>

  <!-- Description -->
  <p class="text-sm md:text-base text-base-content/70 leading-relaxed mb-3">
    {course.description}
  </p>

  <!-- Highlights (tag-like chips) -->
  <div class="flex flex-wrap gap-1.5 mb-3">
    {course.highlights.map((h) => (
      <span class="text-xs font-mono px-2 py-0.5 rounded-md bg-base-300/40 text-base-content/80 border border-base-300/60">
        {h}
      </span>
    ))}
  </div>

  <!-- Meta row: rating, students, duration -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs md:text-sm text-base-content/60 font-mono">
    <span class="inline-flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#f7931e" stroke="#f7931e" stroke-width="1.5">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
      {course.rating.toFixed(1)}
    </span>
    <span class="inline-flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      {course.students.toLocaleString()}명
    </span>
    <span class="inline-flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      {formatDuration(course.durationMinutes)}
    </span>
    <span class="inline-flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      {course.lectures}강
    </span>
  </div>
</a>

<style>
  .course-card {
    border-bottom: 1px solid hsl(var(--b3) / 0.4);
  }
  .course-card:hover {
    border-bottom-color: hsl(var(--p) / 0.5);
  }
</style>
