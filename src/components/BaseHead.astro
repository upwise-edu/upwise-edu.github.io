---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import site from '../data/site.json';
import siteEn from '../data/site.en.json';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	includeStructuredData?: boolean;
	lang?: 'ko' | 'en';
}

const { title, description, image = '/upwise_text.png', ogType = 'website', includeStructuredData = false, lang = 'ko' } = Astro.props;

const keywords = lang === 'en' ? siteEn.site.keywords : site.site.keywords;

// JSON-LD 구조화 데이터 — 메인 페이지에서만 사용 (Person + ProfilePage)
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": "https://upwise.co.kr/#person",
			"name": "이승현",
			"alternateName": "Seunghyun Lee",
			"jobTitle": "GIS·Python 전문 강사",
			"description": "QGIS·Python·원격탐사 활용 GIS 강의 전문 강사",
			"url": "https://upwise.co.kr",
			"image": "https://upwise.co.kr/upwise_text.png",
			"sameAs": [
				"https://www.inflearn.com/users/212773/@upwise",
				"https://open.kakao.com/me/upwise"
			],
			"knowsAbout": [
				"QGIS", "GIS", "Geographic Information System",
				"Remote Sensing", "Python", "PostGIS",
				"Spatial Data Analysis", "Map Visualization", "PyQGIS"
			],
			"alumniOf": {
				"@type": "EducationalOrganization",
				"name": "서울대학교 환경대학원",
				"url": "https://gses.snu.ac.kr"
			},
			"worksFor": {
				"@type": "Organization",
				"name": "UPWISE",
				"url": "https://upwise.co.kr"
			}
		},
		{
			"@type": "Organization",
			"@id": "https://upwise.co.kr/#organization",
			"name": "UPWISE",
			"url": "https://upwise.co.kr",
			"logo": "https://upwise.co.kr/upwise_logo.png",
			"founder": { "@id": "https://upwise.co.kr/#person" },
			"sameAs": [
				"https://www.inflearn.com/users/212773/@upwise"
			]
		},
		{
			"@type": "WebSite",
			"@id": "https://upwise.co.kr/#website",
			"url": "https://upwise.co.kr",
			"name": "UPWISE — GIS 전문 강사",
			"description": site.site.description,
			"inLanguage": "ko-KR",
			"publisher": { "@id": "https://upwise.co.kr/#organization" }
		},
		...site.courses.items.map((course) => ({
			"@type": "Course",
			"name": course.title,
			"description": course.description,
			"provider": {
				"@type": "Organization",
				"name": "Inflearn",
				"sameAs": "https://www.inflearn.com"
			},
			"instructor": { "@id": "https://upwise.co.kr/#person" },
			"url": course.url,
			"image": course.image ? `https://upwise.co.kr${course.image}` : undefined,
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": course.rating,
				"bestRating": 5,
				"ratingCount": parseInt(String(course.students).replace(/\D/g, ''), 10) || 1,
			},
			"offers": course.isFree ? {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "KRW",
				"availability": "https://schema.org/InStock"
			} : undefined,
			"hasCourseInstance": {
				"@type": "CourseInstance",
				"courseMode": "online",
				"courseWorkload": `PT${Math.round(course.durationMinutes / 60)}H${course.durationMinutes % 60}M`
			}
		}))
	]
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/upwise_logo.png" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={Astro.url} />
<meta name="author" content="이승현 (UPWISE)" />
<meta name="robots" content="index, follow" />
<meta http-equiv="content-language" content={lang} />

<!-- hreflang alternates (KR / EN) -->
<link rel="alternate" hreflang="ko" href="https://upwise.co.kr/" />
<link rel="alternate" hreflang="en" href="https://upwise.co.kr/en/" />
<link rel="alternate" hreflang="x-default" href="https://upwise.co.kr/" />

<!-- Search engine verification -->
<meta name="naver-site-verification" content="613456383a86cd0ec8304900bc1e8e5bd07b11e2" />

<!-- Theme detection (runs before paint to avoid flash + re-applies on view transitions) -->
<script is:inline>
  (function () {
    function applyTheme() {
      const saved = localStorage.getItem('upwise-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'upwise-dark' : 'upwise-light');
      document.documentElement.setAttribute('data-theme', theme);
    }
    applyTheme();
    // ViewTransitions: 교체 직전 새 문서에 테마를 미리 적용해 깜빡임 방지
    document.addEventListener('astro:before-swap', function (e) {
      const saved = localStorage.getItem('upwise-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'upwise-dark' : 'upwise-light');
      if (e.newDocument) e.newDocument.documentElement.setAttribute('data-theme', theme);
    });
    // 교체 후에도 한 번 더 보장
    document.addEventListener('astro:after-swap', applyTheme);
  })();
</script>

<!-- Fonts: Pretendard Variable (all roles) + Inter (Latin fallback) -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
  rel="stylesheet"
  as="style"
  crossorigin
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
/>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
/>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- JSON-LD Structured Data (Person, Organization, WebSite, Courses) -->
{includeStructuredData && (
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}

<!-- Google Analytics 4 -->
{site.analytics?.gtagId && (
	<>
		<script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.gtagId}`}></script>
		<script is:inline define:vars={{ gtagId: site.analytics.gtagId }}>
			window.dataLayer = window.dataLayer || [];
			function gtag(){ dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', gtagId);
		</script>
	</>
)}
