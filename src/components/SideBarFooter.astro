<div
    class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

<div class="social-icons px-3 pb-5 pt-1 flex flex-wrap self-center justify-center sticky bottom-0 bg-base-200 gap-1">
    <!-- Kakao open profile (primary contact) -->
    <a
        href="https://open.kakao.com/me/upwise"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-md hover:text-primary hover:bg-base-300 transition-all"
        aria-label="카카오 오픈프로필"
        title="카카오 오픈프로필"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3C6.48 3 2 6.58 2 11c0 2.86 1.87 5.37 4.69 6.79l-1.2 4.37c-.1.37.31.66.62.44L11.27 19c.24.01.48.02.73.02 5.52 0 10-3.58 10-8.02S17.52 3 12 3z"></path>
        </svg>
    </a>

    <!-- Inflearn instructor page (Inflearn-style green badge with "in") -->
    <a
        href="https://www.inflearn.com/users/212773/@upwise"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-md hover:bg-base-300 transition-all flex items-center justify-center"
        aria-label="인프런 강사 페이지"
        title="인프런 강사 페이지"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
            <rect width="24" height="24" rx="5" fill="#1DC078"/>
            <text x="12" y="17" text-anchor="middle" font-family="system-ui, -apple-system, 'Segoe UI', sans-serif" font-weight="800" font-size="12" fill="white" letter-spacing="-0.5">in</text>
        </svg>
    </a>

    <!-- Email -->
    <a
        href="mailto:hello@upwise.kr"
        class="p-2 rounded-md hover:text-primary hover:bg-base-300 transition-all"
        aria-label="Email"
        title="Email"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
    </a>

    <!-- Divider -->
    <span class="w-px bg-base-300 mx-1 my-2"></span>

    <!-- Theme toggle -->
    <button
        id="theme-toggle"
        class="p-2 rounded-md hover:text-primary hover:bg-base-300 transition-all"
        aria-label="Toggle theme"
        title="라이트/다크 모드 전환"
    >
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
    </button>
</div>

<script is:inline>
  (function () {
    const toggle = document.getElementById('theme-toggle');
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    if (!toggle || !sun || !moon) return;

    function syncIcon() {
      const t = document.documentElement.getAttribute('data-theme');
      if (t === 'upwise-dark') {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
      } else {
        moon.classList.remove('hidden');
        sun.classList.add('hidden');
      }
    }
    syncIcon();

    toggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'upwise-dark' ? 'upwise-light' : 'upwise-dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('upwise-theme', next);
      syncIcon();
    });

    document.addEventListener('astro:after-swap', syncIcon);
  })();
</script>
