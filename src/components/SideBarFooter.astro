---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data";
const c = site.contact; // 연락처 정본은 site.json (한/영 동일)
---

<div
    class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

<div class="social-icons px-3 pb-5 pt-1 flex flex-wrap items-center self-center justify-center sticky bottom-0 bg-base-200 gap-1">
    <!-- Kakao open profile -->
    <a
        href={c.kakaoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn"
        aria-label="카카오 오픈프로필"
        title="카카오 오픈프로필"
    >
        <span class="kakao-icon-sm" aria-hidden="true"></span>
    </a>

    <!-- Inflearn instructor page (official logo) -->
    <a
        href={c.inflearnUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn hover:bg-[#00C471]/10"
        aria-label="인프런 강사 페이지"
        title="인프런 강사 페이지"
    >
        <img src="/inflearn_logo-01.svg" alt="" width="20" height="20" class="block" />
    </a>

    <!-- Email -->
    <a
        href={`mailto:${c.email}`}
        class="icon-btn"
        aria-label="Email"
        title="Email"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
    </a>

    <!-- Instagram -->
    <a
        href={c.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn icon-btn-insta"
        aria-label="인스타그램"
        title={`인스타그램 ${c.instagramDisplay}`}
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
    </a>

    <!-- Divider -->
    <span class="w-px h-5 bg-base-300 mx-1"></span>

    <!-- Theme toggle (shared component, syncs with header toggle) -->
    <ThemeToggle variant="plain" />
</div>

<style>
  /* Unified circular icon button — all icons render at 36px square, content centered */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: #f7931e;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .icon-btn:hover {
    background-color: rgba(247, 147, 30, 0.1);
  }
  /* Instagram — matches contact card brand color (#E4405F) */
  .icon-btn-insta {
    color: #e4405f;
  }
  .icon-btn-insta:hover {
    background-color: rgba(228, 64, 95, 0.1);
  }
  .theme-toggle-btn {
    color: hsl(var(--bc) / 0.7);
  }
  .theme-toggle-btn:hover {
    color: #f7931e;
    background-color: hsl(var(--b3));
  }

  /* Kakao logo via CSS mask — picks up currentColor */
  .kakao-icon-sm {
    display: inline-block;
    width: 22px;
    height: 20px;
    background-color: currentColor;
    -webkit-mask: url("/KakaoTalk_logo.svg") no-repeat center / contain;
    mask: url("/KakaoTalk_logo.svg") no-repeat center / contain;
  }
</style>
