---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "active-nav-item";
---

<ul class="menu grow shrink menu-md overflow-y-auto gap-1 px-0">
    <li><a class="py-3 text-base nav-item" id="home" href="/"><span class="nav-bar"></span>Home</a></li>
    <li><a class="py-3 text-base nav-item" id="projects" href="/projects"><span class="nav-bar"></span>Portfolio</a></li>
    <li><a class="py-3 text-base nav-item" id="services" href="/services"><span class="nav-bar"></span>강의 안내</a></li>
    <li><a class="py-3 text-base nav-item" id="cv" href="/cv"><span class="nav-bar"></span>강사 이력</a></li>
    <li><a class="py-3 text-base nav-item" id="blog" href="/blog/"><span class="nav-bar"></span>Blog</a></li>
    <li>
        <a
            class="py-3 text-base nav-item"
            id="contact"
            href="https://open.kakao.com/me/upwise"
            target="_blank"
            rel="noopener noreferrer"><span class="nav-bar"></span>Contact</a
        >
    </li>
</ul>

<style>
  .nav-item {
    position: relative;
    padding-left: 1.5rem !important;
    transition: all 0.2s ease;
    color: hsl(var(--bc) / 0.65);
  }
  .nav-item:hover {
    color: #ff6b35;
    background: transparent !important;
  }
  .nav-bar {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.25rem;
    height: 0;
    background: linear-gradient(180deg, #f7931e, #ff6b35);
    border-radius: 2px;
    transform: translateY(-50%);
    transition: height 0.25s ease;
  }
  .nav-item:hover .nav-bar {
    height: 1.5rem;
  }
  :global(.active-nav-item) {
    color: #ff6b35 !important;
    background: transparent !important;
  }
  :global(.active-nav-item .nav-bar) {
    height: 1.5rem !important;
  }
</style>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
