---
const { sideBarActiveItemID, lang = "ko" } = Astro.props;
const activeClass = "active-nav-item";
const base = lang === "en" ? "/en/" : "/";
const items =
  lang === "en"
    ? [
        { id: "about", label: "About" },
        { id: "courses", label: "Online Courses" },
        { id: "lectures", label: "Teaching" },
        { id: "partners", label: "Partners" },
        { id: "contact", label: "Contact" },
      ]
    : [
        { id: "about", label: "강사 소개" },
        { id: "courses", label: "온라인 강의" },
        { id: "lectures", label: "강의 경력" },
        { id: "partners", label: "협업 기관" },
        { id: "contact", label: "Contact" },
      ];
---

<ul class="menu grow shrink menu-md overflow-y-auto gap-0.5 px-0">
    {items.map((item) => (
        <li><a class="py-2.5 text-base nav-item" id={item.id} href={`${base}#${item.id}`}><span class="nav-bar"></span>{item.label}</a></li>
    ))}
</ul>

<style>
  .nav-item {
    position: relative;
    padding-left: 1.5rem !important;
    transition: all 0.2s ease;
    color: hsl(var(--bc) / 0.65);
  }
  .nav-item:hover {
    color: #ff6b35;
    background: transparent !important;
  }
  .nav-bar {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.25rem;
    height: 0;
    background: linear-gradient(180deg, #f7931e, #ff6b35);
    border-radius: 2px;
    transform: translateY(-50%);
    transition: height 0.25s ease;
  }
  .nav-item:hover .nav-bar {
    height: 1.5rem;
  }
  :global(.active-nav-item) {
    color: #ff6b35 !important;
    background: transparent !important;
    font-weight: 600;
  }
  :global(.active-nav-item .nav-bar) {
    height: 1.5rem !important;
  }
</style>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
