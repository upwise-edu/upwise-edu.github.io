---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ id, data }) => id.startsWith("en/") && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
const slugOf = (s: string) => s.replace(/^en\//, "");
---

<BaseLayout
  lang="en"
  title="Blog | UPWISE — Seunghyeon Lee"
  description="Tips on QGIS, Python, and geospatial analysis, plus course news."
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <section class="pt-10 pb-16 animate-fade-up">
    <p class="type-caption text-primary mb-4">06 — BLOG</p>
    <h1 class="type-display-lg text-base-content mb-4">Blog</h1>
    <p class="type-body-lg text-base-content/75 max-w-2xl mb-12">
      Notes on QGIS, Python, and geospatial analysis, plus course news.
    </p>

    {posts.length === 0 ? (
      <p class="type-body text-base-content/60">No posts published yet.</p>
    ) : (
      <div class="space-y-4">
        {posts.map((post) => (
          <a
            href={`/en/blog/${slugOf(post.slug)}`}
            class="group block p-6 rounded-2xl bg-base-200/50 border border-base-300/60 hover:border-primary/60 hover:bg-base-200/80 transition-all"
          >
            <p class="type-body-sm text-base-content/55 mb-2">{fmt(post.data.date)}</p>
            <h2 class="type-card-title text-base-content group-hover:text-primary transition-colors mb-2">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="type-body text-base-content/70 mb-3 line-clamp-2">{post.data.description}</p>
            )}
            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.map((t) => (
                  <span class="text-[11px] px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
                    {t}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
