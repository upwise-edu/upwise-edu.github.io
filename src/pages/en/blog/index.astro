---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import { getPosts, categoryCounts, tagCounts, PAGE_SIZE } from "../../../lib/blog";

const all = await getPosts("en");
const posts = all.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const categories = categoryCounts(all);
const tags = tagCounts(all);
---

<BaseLayout
  lang="en"
  title="Blog | UPWISE — Seunghyeon Lee"
  description="Tips on QGIS, Python, and geospatial analysis, plus course news."
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <BlogList lang="en" posts={posts} total={all.length} grandTotal={all.length} categories={categories} tags={tags} page={1} totalPages={totalPages} />
</BaseLayout>
