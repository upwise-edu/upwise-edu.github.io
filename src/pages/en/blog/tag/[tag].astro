---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BlogList from "../../../../components/BlogList.astro";
import { getPosts, tagCounts } from "../../../../lib/blog";

export async function getStaticPaths() {
  const all = await getPosts("en");
  const tags = tagCounts(all);
  return tags.map(({ tag }) => {
    const posts = all.filter((p) => p.data.tags.includes(tag));
    return { params: { tag }, props: { tag, posts, total: posts.length, tags } };
  });
}

const { tag, posts, total, tags } = Astro.props;
---

<BaseLayout
  lang="en"
  title={`Tag '${tag}' | UPWISE Blog`}
  description={`Posts tagged ${tag}`}
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <BlogList lang="en" posts={posts} total={total} tags={tags} activeTag={tag} />
</BaseLayout>
