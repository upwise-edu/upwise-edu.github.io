---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ id }) => id.startsWith("en/"));
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^en\//, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---

<BaseLayout
  lang="en"
  title={`${post.data.title} | UPWISE Blog`}
  description={post.data.description}
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <article class="pt-10 pb-16 animate-fade-up max-w-2xl">
    <a href="/en/blog/" class="type-body-sm text-primary hover:underline">← Back to blog</a>
    <h1 class="type-display-lg text-base-content mt-4 mb-3">{post.data.title}</h1>
    <p class="type-body-sm text-base-content/55 mb-8">{fmt(post.data.date)}</p>

    <div class="prose prose-slate dark:prose-invert max-w-none prose-a:text-primary prose-headings:text-base-content prose-img:rounded-xl">
      <Content />
    </div>
  </article>
</BaseLayout>
