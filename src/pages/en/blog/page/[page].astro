---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BlogList from "../../../../components/BlogList.astro";
import { getPosts, categoryCounts, PAGE_SIZE, chunk } from "../../../../lib/blog";

export async function getStaticPaths() {
  const all = await getPosts("en");
  const pages = chunk(all, PAGE_SIZE);
  const categories = categoryCounts(all);
  return pages
    .map((posts, i) => ({
      params: { page: String(i + 1) },
      props: { posts, total: all.length, totalPages: pages.length, page: i + 1, categories },
    }))
    .filter((p) => p.props.page >= 2);
}

const { posts, total, totalPages, page, categories } = Astro.props;
---

<BaseLayout
  lang="en"
  title={`Blog (page ${page}) | UPWISE`}
  description="Tips on QGIS, Python, and geospatial analysis."
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <BlogList lang="en" posts={posts} total={total} grandTotal={total} categories={categories} page={page} totalPages={totalPages} />
</BaseLayout>
