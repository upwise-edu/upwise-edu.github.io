---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { fmtDate } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ id }) => id.startsWith("en/"));
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^en\//, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const base = Astro.site.href.replace(/\/$/, "");
const jsonld = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Seunghyeon Lee", url: base },
  publisher: {
    "@type": "Organization",
    name: "UPWISE",
    logo: { "@type": "ImageObject", url: `${base}/upwise_logo.png` },
  },
  mainEntityOfPage: pageUrl,
  inLanguage: "en-US",
  ...(post.data.cover ? { image: new URL(post.data.cover, Astro.site).href } : {}),
};
---

<BaseLayout
  lang="en"
  title={`${post.data.title} | UPWISE Blog`}
  description={post.data.description}
  image={post.data.cover}
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <article class="pt-10 pb-16 animate-fade-up max-w-2xl">
    <a href="/en/blog/" class="type-body-sm text-primary hover:underline">← Back to blog</a>
    <div class="flex items-center gap-2 mt-4 mb-3">
      <a href={`/en/blog/category/${encodeURIComponent(post.data.category)}/`} class="text-[11px] px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20">{post.data.category}</a>
      <span class="type-body-sm text-base-content/55">{fmtDate(post.data.date)}</span>
    </div>
    <h1 class="type-display-lg text-base-content mb-3">{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {post.data.tags.map((tg) => (
          <span class="text-xs text-base-content/55">#{tg}</span>
        ))}
      </div>
    )}
    <div class="prose prose-slate dark:prose-invert max-w-none prose-a:text-primary prose-headings:text-base-content prose-img:rounded-xl">
      <Content />
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
</BaseLayout>
