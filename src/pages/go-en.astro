---
import site from "../data/site.json";

// English QR redirect page.
// Destination is managed in site.json → qrTargetEn.url
const destination = site.qrTargetEn.url;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>UPWISE — Redirecting…</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta http-equiv="refresh" content={`0; url=${destination}`} />
  <link rel="canonical" href={destination} />
  <script is:inline define:vars={{ destination }}>
    window.location.replace(destination);
  </script>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Pretendard Variable", sans-serif;
      background: #0a1929;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      text-align: center;
    }
    a { color: #f7931e; }
  </style>
</head>
<body>
  <div>
    <p>Redirecting to UPWISE…</p>
    <p><a href={destination}>{destination}</a></p>
  </div>
</body>
</html>
