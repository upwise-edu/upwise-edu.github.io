---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import { getPosts, categoryCounts, tagCounts } from "../../../lib/blog";

export async function getStaticPaths() {
  const all = await getPosts("ko");
  const categories = categoryCounts(all);
  const tags = tagCounts(all);
  return tags.map(({ tag }) => {
    const posts = all.filter((p) => p.data.tags.includes(tag));
    return {
      params: { tag },
      props: { tag, posts, total: posts.length, grandTotal: all.length, categories, tags },
    };
  });
}

const { tag, posts, total, grandTotal, categories, tags } = Astro.props;
---

<BaseLayout
  lang="ko"
  title={`#${tag} 태그 | UPWISE 블로그`}
  description={`${tag} 태그 글 모음`}
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <BlogList
    lang="ko"
    posts={posts}
    total={total}
    grandTotal={grandTotal}
    categories={categories}
    tags={tags}
    activeTag={tag}
  />
</BaseLayout>
