---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "../../components/BlogList.astro";
import { getPosts, categoryCounts, tagCounts, PAGE_SIZE } from "../../lib/blog";

const all = await getPosts("ko");
const posts = all.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const categories = categoryCounts(all);
const tags = tagCounts(all);
---

<BaseLayout
  lang="ko"
  title="블로그 | UPWISE 이승현"
  description="QGIS·Python·공간정보 팁과 강의 소식 — UPWISE GIS 강사 블로그"
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <BlogList lang="ko" posts={posts} total={all.length} grandTotal={all.length} categories={categories} tags={tags} page={1} totalPages={totalPages} />
</BaseLayout>
