---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import { getPosts, categoryCounts, tagCounts, PAGE_SIZE, chunk } from "../../../lib/blog";

export async function getStaticPaths() {
  const all = await getPosts("ko");
  const pages = chunk(all, PAGE_SIZE);
  const categories = categoryCounts(all);
  const tags = tagCounts(all);
  return pages
    .map((posts, i) => ({
      params: { page: String(i + 1) },
      props: { posts, total: all.length, totalPages: pages.length, page: i + 1, categories, tags },
    }))
    .filter((p) => p.props.page >= 2); // 1페이지는 /blog/ 에서 처리
}

const { posts, total, totalPages, page, categories, tags } = Astro.props;
---

<BaseLayout
  lang="ko"
  title={`블로그 (${page}페이지) | UPWISE 이승현`}
  description="QGIS·Python·공간정보 팁과 강의 소식"
  langKoHref="/blog/"
  langEnHref="/en/blog/"
  sideBarActiveItemID="blog"
  noindex={true}
>
  <BlogList lang="ko" posts={posts} total={total} grandTotal={total} categories={categories} tags={tags} page={page} totalPages={totalPages} />
</BaseLayout>
