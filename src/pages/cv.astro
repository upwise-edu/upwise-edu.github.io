---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { instructorStats, courses } from "../data/courses";

const totalLectures = courses.reduce((s, c) => s + c.lectures, 0);
const totalMinutes = courses.reduce((s, c) => s + c.durationMinutes, 0);
const totalHours = Math.round(totalMinutes / 60);
---

<BaseLayout title="강사 이력 | upwise." sideBarActiveItemID="cv">
  <section class="pb-12 pt-8 animate-fade-up">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">CV</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4">강사 이력</h1>
    <p class="text-base-content/70 leading-relaxed max-w-2xl">
      서울대학교 환경대학원에서 GIS와 원격탐사를 전공하고,
      연구와 강의를 병행하고 있습니다.
    </p>
  </section>

  <!-- At a glance stats -->
  <section class="pb-12 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-4">AT A GLANCE</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">누적 수강생</p>
        <p class="text-2xl font-bold text-primary">{instructorStats.totalStudents.toLocaleString()}<span class="text-base font-normal text-base-content/60 ml-1">명</span></p>
      </div>
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">평균 평점</p>
        <p class="text-2xl font-bold text-primary">{instructorStats.averageRating}<span class="text-base font-normal text-base-content/60 ml-1">/5.0</span></p>
      </div>
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">총 강의량</p>
        <p class="text-2xl font-bold text-primary">{totalHours}<span class="text-base font-normal text-base-content/60 ml-1">시간 · {totalLectures}강</span></p>
      </div>
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">수강평</p>
        <p class="text-2xl font-bold text-primary">{instructorStats.totalReviews}<span class="text-base font-normal text-base-content/60 ml-1">건</span></p>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="pb-12 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-4">EDUCATION</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-6">학력</h2>
    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title="박사 과정 수료"
        subtitle="서울대학교 환경대학원 · GIS / Remote Sensing 전공"
      />
      <TimeLineElement
        title="석사 졸업"
        subtitle="서울대학교 환경대학원 · GIS / Remote Sensing 전공"
      />
    </div>
  </section>

  <!-- Expertise -->
  <section class="pb-12 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-4">EXPERTISE</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-6">전문 분야</h2>
    <div class="time-line-container">
      <TimeLineElement
        title="GIS · 공간정보 분석"
        subtitle="QGIS · ArcGIS · 공간자료 분석 및 시각화"
      >
        벡터/래스터 자료의 수집·전처리·분석·시각화 전 과정. 공공데이터·위성영상·현장조사 자료의 통합 활용.
      </TimeLineElement>
      <TimeLineElement
        title="원격탐사 (Remote Sensing)"
        subtitle="위성영상 분석 · 식생/토지피복 모니터링"
      >
        Landsat·Sentinel·MODIS 등 위성영상을 활용한 환경 모니터링 연구 경험.
      </TimeLineElement>
      <TimeLineElement
        title="Python × GIS 융합"
        subtitle="GeoPandas · Rasterio · PyQGIS"
      >
        파이썬 기반 공간데이터 처리 자동화. 반복 작업을 코드로 효율화하는 워크플로우 구축.
      </TimeLineElement>
    </div>
  </section>

  <!-- Teaching -->
  <section class="pb-12 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-4">TEACHING</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-6">강의 활동</h2>
    <div class="time-line-container">
      <TimeLineElement
        title="인프런 온라인 강의"
        subtitle={`${courses.length}개 강의 운영 · 누적 ${instructorStats.totalStudents.toLocaleString()}명 수강 · 평점 ${instructorStats.averageRating}`}
      >
        QGIS 입문부터 파이썬 자동화까지 단계별 학습 로드맵 제공.
        무료 강의를 시작으로 시각화·자동화 심화까지 자연스럽게 이어지는 커리큘럼 설계.
      </TimeLineElement>
      <TimeLineElement
        title="1:1 멘토링 (인프런)"
        subtitle={`평점 ${instructorStats.mentoringRating}점`}
      >
        수강생 개별 프로젝트와 진로에 맞춘 맞춤형 멘토링 제공.
      </TimeLineElement>
    </div>
  </section>

  <!-- Skills -->
  <section class="pb-16 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-4">SKILLS</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-6">기술 스택</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="font-mono text-sm text-primary mb-2">GIS Software</p>
        <ul class="space-y-1 text-base-content/80 text-sm">
          <li>QGIS</li>
          <li>ArcGIS Pro</li>
          <li>PostGIS</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-sm text-primary mb-2">Programming</p>
        <ul class="space-y-1 text-base-content/80 text-sm">
          <li>Python (GeoPandas, Rasterio, PyQGIS)</li>
          <li>R (sf, terra)</li>
          <li>SQL · JavaScript</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-sm text-primary mb-2">Visualization</p>
        <ul class="space-y-1 text-base-content/80 text-sm">
          <li>QGIS Layout</li>
          <li>Leaflet · MapLibre</li>
          <li>Matplotlib · Plotly</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
