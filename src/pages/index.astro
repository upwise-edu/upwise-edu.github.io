---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import site, {
  courses,
  offlineLectures, groupLecturesByYear, lectureStats,
  collaborations,
} from "../data";

const totalLectures = courses.reduce((s, c) => s + c.lectures, 0);
const totalMinutes = courses.reduce((s, c) => s + c.durationMinutes, 0);
const totalHours = Math.round(totalMinutes / 60);

const lecturesByYear = groupLecturesByYear(offlineLectures);
const lectStats = lectureStats(offlineLectures);

// 강의 날짜 포맷 헬퍼 — "2025-03-15" → "2025.03.15", 범위면 "2025.03.15 ~ 2025.03.17"
const fmtDate = (d: string) => d.replace(/-/g, '.');
const formatLectureDate = (date: string, dateEnd?: string | null) =>
  dateEnd ? `${fmtDate(date)} ~ ${fmtDate(dateEnd)}` : fmtDate(date);

const orderedCourses = [
  courses.find((c) => c.id === 'free-election'),
  courses.find((c) => c.id === 'starter'),
  courses.find((c) => c.id === 'viz'),
  courses.find((c) => c.id === 'automation'),
].filter(Boolean) as typeof courses;

const categoryMeta = site.courses.categoryMeta as Record<string, { label: string; description: string; icon: string }>;

// 전화번호 봇 회피용 인코딩 — 평문 대신 char code 배열로 HTML에 삽입.
// 일반 봇은 이를 전화번호로 인식 못 함. JS가 hover/click 시점에 복원.
const phoneChars = [...site.contact.phone].map((c) => c.charCodeAt(0));
const telChars   = [...site.contact.phoneTelLink].map((c) => c.charCodeAt(0));
---

<BaseLayout sideBarActiveItemID="about">
  <!-- ───────── HERO ───────── -->
  <section id="top" class="pb-20 pt-10 scroll-mt-12 animate-fade-up">
    <p class="type-eyebrow text-primary mb-6">{site.hero.eyebrow}</p>

    <h1 class="type-display-xl mb-6 leading-[0.95]">
      <span class="text-primary">UP</span><span class="text-base-content">WISE</span><span class="text-primary">.</span>
    </h1>

    <p class="type-headline text-base-content/90 mb-8 max-w-2xl whitespace-pre-line">
      {site.hero.taglineLead}<br/>
      {site.hero.taglineHighlight.split(/(GIS)/).map((part) => (
        part === 'GIS'
          ? <span style="color:#00C471;font-weight:900;">{part}</span>
          : <span class="text-primary" style="font-weight:900;">{part}</span>
      ))}{site.hero.taglineSuffix}
    </p>

    <p class="type-body text-base-content/70 max-w-2xl mb-10 whitespace-pre-line">
      {site.hero.description}
    </p>

    <!-- Social proof -->
    <div class="color-block color-block-orange-soft mb-10" style="padding:20px 24px;">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        {site.hero.stats.map((stat, i) => (
          <>
            {i > 0 && <span class="text-base-content/30 hidden md:inline">·</span>}
            <div class="flex items-center gap-2">
              {i === 0 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#f7931e" stroke="#f7931e" stroke-width="1.5">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              )}
              <span class="type-body-sm"><strong>{stat.value}</strong><span class="text-base-content/60">{stat.suffix}</span></span>
            </div>
          </>
        ))}
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary gap-2" href="#courses">
        {site.hero.ctaPrimary}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <a href={site.contact.kakaoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary gap-2">
        {site.hero.ctaSecondary}
      </a>
    </div>
  </section>

  <!-- ───────── ABOUT (강사 소개 — CV 통합) ───────── -->
  <section id="about" class="scroll-section pb-24 border-t border-base-300 pt-16 scroll-mt-12">
    <p class="type-caption text-primary mb-4">{site.about.eyebrow}</p>
    <h3 class="type-display-lg text-base-content mb-10">{site.about.title}</h3>

    <!-- Intro narrative — stats 그리드와 동일한 너비로 확장 -->
    <div class="space-y-5 mb-12">
      {site.about.paragraphs.map((p, i) => (
        <p class={(i === 0 ? "type-body-lg text-base-content/85" : "type-body text-base-content/75") + " whitespace-pre-line"}>
          {p}
        </p>
      ))}
      <p class="type-body text-base-content/75">
        {site.about.expertiseLine}
        {site.about.expertiseAreas.map((area, i) => (
          <>
            <span class="text-primary" style="font-weight:480;">{area}</span>{i < site.about.expertiseAreas.length - 1 ? ', ' : ''}
          </>
        ))}{site.about.expertiseLineSuffix}
      </p>
    </div>

    <!-- Stats at a glance (2x3 on desktop, 2x3 on mobile) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12">
      {site.about.stats.map((stat) => (
        <div class="p-5 rounded-2xl bg-base-200/60 border border-base-300/60">
          <p class="type-caption text-base-content/55 mb-2">{stat.label}</p>
          <p class="type-display-lg text-primary" style="font-size:32px;line-height:1;">{stat.value}<span class="text-sm font-normal text-base-content/55 ml-1">{stat.unit}</span></p>
        </div>
      ))}
    </div>

    <!-- Education -->
    <p class="type-eyebrow text-primary mb-5">EDUCATION</p>
    <div class="time-line-container grid gap-4 mb-12">
      {site.about.education.map((e) => (
        <TimeLineElement title={e.title} subtitle={e.subtitle} />
      ))}
    </div>

    <!-- Expertise (detailed) -->
    <p class="type-eyebrow text-primary mb-5">EXPERTISE</p>
    <div class="time-line-container">
      {site.about.expertise.map((e) => (
        <TimeLineElement title={e.title} subtitle={e.subtitle}>
          {e.body}
        </TimeLineElement>
      ))}
    </div>
  </section>

  <!-- ───────── ONLINE COURSES ───────── -->
  <section id="courses" class="scroll-section pb-24 border-t border-base-300 pt-16 scroll-mt-12">
    <p class="type-caption text-primary mb-4">{site.courses.eyebrow}</p>
    <h3 class="type-display-lg mb-4">{site.courses.title}</h3>
    <p class="type-body-lg text-base-content/75 max-w-2xl mb-12 whitespace-pre-line">{site.courses.intro}</p>

    <!-- Roadmap chips -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-14">
      {(['입문', '시각화', '자동화'] as const).map((cat, idx) => (
        <div class="p-5 rounded-2xl bg-base-200/60 border border-base-300/60">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-2xl">{categoryMeta[cat].icon}</span>
            <p class="type-caption text-primary">STEP {idx + 1}</p>
          </div>
          <h4 class="type-card-title mb-1">{cat}</h4>
          <p class="type-body-sm text-base-content/65 leading-relaxed">
            {categoryMeta[cat].description}
          </p>
        </div>
      ))}
    </div>

    <!-- Online course cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {orderedCourses.map((course) => <CourseCard course={course} />)}
    </div>
  </section>

  <!-- ───────── OFFLINE LECTURES ───────── -->
  <section id="lectures" class="scroll-section pb-24 border-t border-base-300 pt-16 scroll-mt-12">
    <p class="type-caption text-primary mb-4">{site.lectures.eyebrow}</p>
    <h3 class="type-display-lg mb-4">{site.lectures.title}</h3>
    <p class="type-body-lg text-base-content/75 max-w-2xl mb-6 whitespace-pre-line">{site.lectures.intro}</p>
    <p class="type-body-sm text-base-content/60 mb-10">
      누적 <strong class="text-base-content" style="font-weight:540;">{lectStats.totalCount}건 이상</strong>의 출강
      · <strong class="text-base-content" style="font-weight:540;">{lectStats.uniqueOrgs}개 기관·기업</strong>
      {lectStats.totalHours > 0 && (
        <> · 총 <strong class="text-base-content" style="font-weight:540;">{lectStats.totalHours}시간 이상</strong></>
      )}
    </p>

    <div class="space-y-10 pl-4 border-l-2 border-base-300/40">
      {lecturesByYear.map(({ year, items }) => (
        <div class="relative">
          <div class="absolute -left-[1.45rem] top-1.5 flex items-center">
            <span class="w-3 h-3 rounded-full bg-primary ring-4 ring-base-100"></span>
          </div>
          <h5 class="text-3xl text-primary mb-4" style="font-weight:700;letter-spacing:-0.5px;">{year}</h5>
          <div class="space-y-1.5">
            {items.map((l) => (
              <div class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 py-2.5 hover:bg-base-200/40 -mx-2 px-2 rounded-md transition-colors">
                <span class="shrink-0 type-caption text-base-content/55 whitespace-nowrap w-fit md:w-32">
                  {formatLectureDate(l.date, l.dateEnd)}
                </span>
                <span class="shrink-0 type-caption px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 w-fit">
                  {l.organization}
                </span>
                <span class="flex-1 type-body text-base-content" style="font-weight:480;">
                  {l.title}
                </span>
                <span class="type-caption text-base-content/55 whitespace-nowrap">
                  {l.audience} · {l.attendees}명{l.hours ? ` · ${l.hours}h` : ''}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Custom request box -->
    <div class="mt-14 color-block color-block-orange-soft">
      <h4 class="type-headline mb-3">{site.customRequest.title}</h4>
      <p class="type-body text-base-content/75 mb-6 max-w-xl whitespace-pre-line">{site.customRequest.description}</p>
      <a href="#contact" class="inline-flex items-center gap-1 type-link text-primary hover:underline">
        {site.customRequest.ctaText}
      </a>
    </div>
  </section>

  <!-- ───────── PARTNERS ───────── -->
  <section id="partners" class="scroll-section pb-24 border-t border-base-300 pt-16 scroll-mt-12">
    <p class="type-caption text-primary mb-4">{site.partners.eyebrow}</p>
    <h3 class="type-display-lg mb-4">{site.partners.title}</h3>
    <p class="type-body-lg text-base-content/75 max-w-2xl mb-12 whitespace-pre-line">{site.partners.intro}</p>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {collaborations.map((c) => (
        <div class="group relative flex flex-col items-center justify-center text-center p-4 min-h-[120px] rounded-2xl bg-base-200/40 border border-base-300/60 hover:border-primary/60 hover:bg-base-200/80 transition-all">
          {c.logo ? (
            <>
              <div class="partner-logo-wrap flex-1 flex items-center justify-center w-full mb-3 min-h-[52px] rounded-md px-2">
                <img
                  src={c.logo}
                  alt={c.name}
                  class="max-h-12 max-w-full object-contain"
                  loading="lazy"
                />
              </div>
              <p class="text-sm md:text-base text-base-content group-hover:text-primary transition-colors text-center leading-tight" style="font-weight:700;">
                {c.name}
              </p>
            </>
          ) : (
            <>
              <p class="text-sm md:text-base text-base-content group-hover:text-primary transition-colors text-center" style="font-weight:700;">
                {c.name}
              </p>
              {c.nameEn && (
                <p class="type-caption text-base-content/45 mt-1">
                  {c.nameEn}
                </p>
              )}
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── CONTACT — navy color block ───────── -->
  <section id="contact" class="scroll-section pt-16 pb-12 scroll-mt-12">
    <div class="color-block color-block-navy">
      <p class="type-caption mb-4">{site.contact.eyebrow}</p>
      <h3 class="type-display-lg mb-5">{site.contact.title}</h3>
      <p class="type-body-lg mb-10 max-w-xl text-base-content/75 dark:text-slate-300 whitespace-pre-line">{site.contact.description}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Kakao -->
        <a
          href={site.contact.kakaoUrl}
          target="_blank" rel="noopener noreferrer"
          class="group flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-white/5 border border-base-300/60 dark:border-white/10 hover:border-primary/60 hover:bg-orange-50 dark:hover:bg-white/10 transition-all shadow-sm dark:shadow-none"
        >
          <div class="shrink-0 w-12 h-12 rounded-xl bg-primary/15 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
            <span class="kakao-icon-md" aria-hidden="true"></span>
          </div>
          <div class="min-w-0">
            <p class="type-caption text-primary mb-1">{site.contact.kakaoLabel}</p>
            <p class="type-body text-base-content dark:text-slate-200 group-hover:text-primary transition-colors" style="font-weight:600;">{site.contact.kakaoName}</p>
            <p class="text-xs text-base-content/55 dark:text-white/45 group-hover:text-base-content dark:group-hover:text-white truncate transition-colors" style="font-family:var(--font-sans);">{site.contact.kakaoDisplay}</p>
          </div>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${site.contact.email}`}
          class="group flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-white/5 border border-base-300/60 dark:border-white/10 hover:border-primary/60 hover:bg-orange-50 dark:hover:bg-white/10 transition-all shadow-sm dark:shadow-none"
        >
          <div class="shrink-0 w-12 h-12 rounded-xl bg-primary/15 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="type-caption text-primary mb-1">EMAIL</p>
            <p class="type-body text-base-content dark:text-slate-200 group-hover:text-primary transition-colors" style="font-weight:600;">{site.contact.emailName}</p>
            <p class="text-xs text-base-content/55 dark:text-white/45 group-hover:text-base-content dark:group-hover:text-white truncate transition-colors" style="font-family:var(--font-sans);">{site.contact.email}</p>
          </div>
        </a>

        <!-- Phone — 봇 보호: HTML에 번호 없음, hover/click 시 JS가 복원 -->
        <a
          id="phone-card"
          href="#"
          class="group flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-white/5 border border-base-300/60 dark:border-white/10 hover:border-primary/60 hover:bg-orange-50 dark:hover:bg-white/10 transition-all shadow-sm dark:shadow-none"
        >
          <div class="shrink-0 w-12 h-12 rounded-xl bg-primary/15 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="min-w-0">
            <p class="type-caption text-primary mb-1">PHONE</p>
            <p class="type-body text-base-content dark:text-slate-200 group-hover:text-primary transition-colors" style="font-weight:600;">{site.contact.phoneName}</p>
            <p id="phone-display" class="text-xs text-base-content/55 dark:text-white/45 group-hover:text-base-content dark:group-hover:text-white truncate transition-colors" style="font-family:var(--font-sans);">마우스를 올리거나 탭하여 보기</p>
          </div>
        </a>

        <!-- Inflearn -->
        <a
          href={site.contact.inflearnUrl}
          target="_blank" rel="noopener noreferrer"
          class="group flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-white/5 border border-base-300/60 dark:border-white/10 hover:border-primary/60 hover:bg-orange-50 dark:hover:bg-white/10 transition-all shadow-sm dark:shadow-none"
        >
          <div class="shrink-0 w-12 h-12 rounded-xl bg-[#00C471]/15 text-[#00C471] flex items-center justify-center group-hover:bg-[#00C471] group-hover:text-white transition-colors">
            <span class="inflearn-icon-md" aria-hidden="true"></span>
          </div>
          <div class="min-w-0">
            <p class="type-caption mb-1" style="color:#00C471;">INFLEARN</p>
            <p class="type-body text-base-content dark:text-slate-200 group-hover:text-[#00C471] transition-colors" style="font-weight:600;">{site.contact.inflearnName}</p>
            <p class="text-xs text-base-content/55 dark:text-white/45 group-hover:text-base-content dark:group-hover:text-white truncate transition-colors" style="font-family:var(--font-sans);">{site.contact.inflearnDescription}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── Phone reveal — only while hovered/focused (bot protection) ───────── -->
  <script is:inline define:vars={{ phoneChars, telChars }}>
    (function () {
      const card = document.getElementById('phone-card');
      const disp = document.getElementById('phone-display');
      if (!card || !disp) return;
      const placeholder = disp.textContent;
      let hideTimer = null;

      function show() {
        disp.textContent = String.fromCharCode.apply(null, phoneChars);
        card.setAttribute('href', 'tel:' + String.fromCharCode.apply(null, telChars));
      }
      function hide() {
        disp.textContent = placeholder;
        card.setAttribute('href', '#');
      }

      // Desktop: show while hovered/focused, hide when leaving
      card.addEventListener('mouseenter', show);
      card.addEventListener('mouseleave', hide);
      card.addEventListener('focus', show);
      card.addEventListener('blur', hide);

      // Mobile: tap reveals temporarily (5s) then hides
      card.addEventListener('touchstart', function () {
        show();
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hide, 5000);
      }, { passive: true });

      // First click on hidden state shows it (not navigating). Once visible, click navigates.
      card.addEventListener('click', function (e) {
        if (disp.textContent === placeholder) {
          e.preventDefault();
          show();
          clearTimeout(hideTimer);
          hideTimer = setTimeout(hide, 5000);
        }
      });
    })();
  </script>

  <!-- ───────── Scroll-spy ───────── -->
  <script is:inline>
    (function () {
      function init() {
        const allSections = Array.from(document.querySelectorAll('section[id]'));
        const navLinks = document.querySelectorAll('.nav-item');
        if (!allSections.length || !navLinks.length) return;

        const linkById = new Map();
        navLinks.forEach((l) => {
          const href = l.getAttribute('href') || '';
          const id = href.startsWith('#') ? href.slice(1)
                   : href.startsWith('/#') ? href.slice(2)
                   : null;
          if (id) linkById.set(id, l);
        });

        const tracked = allSections.filter((s) => linkById.has(s.id));
        if (!tracked.length) return;

        function setActive(id) {
          navLinks.forEach((l) => l.classList.remove('active-nav-item'));
          const link = linkById.get(id);
          if (link) link.classList.add('active-nav-item');
        }

        function update() {
          const nearBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
          if (nearBottom) {
            setActive(tracked[tracked.length - 1].id);
            return;
          }

          const trigger = window.scrollY + window.innerHeight * 0.30;
          let current = tracked[0];
          for (const s of tracked) {
            const top = s.getBoundingClientRect().top + window.scrollY;
            if (top <= trigger) {
              current = s;
            } else {
              break;
            }
          }
          if (current) setActive(current.id);
        }

        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => { update(); ticking = false; });
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update);
        document.addEventListener('astro:after-swap', update);
        update();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
