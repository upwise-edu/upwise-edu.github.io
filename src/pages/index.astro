---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"
import { courses, instructorStats } from "../data/courses";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_posts = posts.slice(0, 3);

const totalLectures = courses.reduce((s, c) => s + c.lectures, 0);
const totalMinutes = courses.reduce((s, c) => s + c.durationMinutes, 0);
const totalHours = Math.round(totalMinutes / 60);

const byCategory = {
  '입문': courses.filter((c) => c.category === '입문'),
  '시각화': courses.filter((c) => c.category === '시각화'),
  '자동화': courses.filter((c) => c.category === '자동화'),
};

const categoryMeta: Record<string, { label: string; description: string; icon: string }> = {
  '입문': { label: 'BEGINNER', description: 'QGIS를 처음 만나는 분께.', icon: '🌱' },
  '시각화': { label: 'VISUALIZATION', description: '발표·보고서·콘텐츠용 지도가 필요한 분께.', icon: '🗺️' },
  '자동화': { label: 'AUTOMATION', description: '반복 GIS 작업을 코드로 효율화하고 싶은 분께.', icon: '⚡' },
};
---

<BaseLayout sideBarActiveItemID="about">
  <!-- ───────── HERO ───────── -->
  <section id="top" class="pb-16 pt-8 scroll-mt-12 animate-fade-up">
    <p class="font-mono text-sm text-primary tracking-wider mb-4">
      HELLO, WELCOME.
    </p>
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-5 leading-tight">
      <span class="font-serif">up</span><span class="text-primary font-serif">wise.</span>
    </h1>
    <h2 class="text-2xl md:text-3xl text-base-content/80 font-light mb-6 leading-relaxed">
      누적 <span class="font-bold text-primary">{instructorStats.totalStudents.toLocaleString()}</span>명이 선택한<br/>
      <span class="text-primary font-medium">QGIS 전문 강사</span>입니다.
    </h2>
    <p class="text-base text-base-content/70 leading-relaxed max-w-2xl mb-8">
      서울대학교 환경대학원 출신, QGIS·Python을 활용한 공간 데이터 분석과 시각화를 가르칩니다.
      입문자도 끝까지 따라올 수 있는 설명과 실전 예제로,
      배운 즉시 현장에서 쓸 수 있는 강의를 만듭니다.
    </p>

    <!-- Social proof -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-4 px-5 rounded-lg bg-base-200/60 border border-base-300/60 mb-8">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="#f7931e" stroke="#f7931e" stroke-width="1.5">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="font-mono text-sm"><span class="font-bold text-base-content">{instructorStats.averageRating}</span><span class="text-base-content/60">/5.0 평점</span></span>
      </div>
      <span class="text-base-content/30 hidden md:inline">·</span>
      <div class="flex items-center gap-2">
        <span class="font-mono text-sm"><span class="font-bold text-base-content">{instructorStats.totalStudents.toLocaleString()}</span><span class="text-base-content/60">명 수강</span></span>
      </div>
      <span class="text-base-content/30 hidden md:inline">·</span>
      <div class="flex items-center gap-2">
        <span class="font-mono text-sm"><span class="font-bold text-base-content">{instructorStats.totalReviews}</span><span class="text-base-content/60">개 수강평</span></span>
      </div>
      <span class="text-base-content/30 hidden md:inline">·</span>
      <div class="flex items-center gap-2">
        <span class="font-mono text-sm"><span class="font-bold text-base-content">{instructorStats.totalCourses}</span><span class="text-base-content/60">개 강의 운영</span></span>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary gap-2" href="#courses">
        강의 보러가기
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <a href="https://open.kakao.com/me/upwise" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary gap-2">
        멘토링 문의
      </a>
    </div>
  </section>

  <!-- ───────── ABOUT ───────── -->
  <section id="about" class="scroll-section pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">01. ABOUT</p>
    <h3 class="text-3xl md:text-4xl font-bold mb-8">소개</h3>
    <div class="text-base-content/80 leading-relaxed space-y-4 max-w-2xl">
      <p>
        지리정보시스템(GIS)을 통해 데이터에 공간적 맥락을 부여하고,
        그 의미를 현장에서 활용 가능한 형태로 전달하는 것을 목표로 합니다.
      </p>
      <p>
        서울대학교 환경대학원에서 GIS와 원격탐사(Remote Sensing)를 전공했으며,
        공간자료를 활용한 연구와 강의를 병행하고 있습니다.
      </p>
      <p>
        주요 강의 분야는
        <span class="text-primary font-medium">QGIS 기초·심화</span>,
        <span class="text-primary font-medium">지도 시각화</span>,
        <span class="text-primary font-medium">QGIS × Python 자동화</span>입니다.
      </p>
    </div>
  </section>

  <!-- ───────── COURSES ───────── -->
  <section id="courses" class="scroll-section pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">02. COURSES</p>
    <h3 class="text-3xl md:text-4xl font-bold mb-3">강의 안내</h3>
    <p class="text-base-content/70 leading-relaxed max-w-2xl mb-10">
      QGIS를 단계별로 익힐 수 있도록 <strong>입문 → 시각화 → 자동화</strong> 순으로 구성했습니다.
      지금 본인에게 필요한 트랙부터 시작하세요.
    </p>

    <!-- Roadmap -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-12">
      {(['입문', '시각화', '자동화'] as const).map((cat, idx) => (
        <a href={`#cat-${cat}`} class="block p-5 rounded-lg bg-base-200/60 border border-base-300/60 hover:border-primary/60 transition-all">
          <div class="text-2xl mb-2">{categoryMeta[cat].icon}</div>
          <p class="font-mono text-xs text-primary tracking-wider mb-1">STEP {idx + 1}</p>
          <h4 class="font-bold text-lg mb-2">{cat}</h4>
          <p class="text-sm text-base-content/70 leading-relaxed">
            {categoryMeta[cat].description}
          </p>
        </a>
      ))}
    </div>

    <!-- Courses by category -->
    {(['입문', '시각화', '자동화'] as const).map((cat) => (
      <div id={`cat-${cat}`} class="mb-10 scroll-mt-12">
        <h4 class="text-xl md:text-2xl font-bold mb-2 flex items-center gap-2">
          <span>{categoryMeta[cat].icon}</span>{cat}
          <span class="font-mono text-xs text-base-content/40 ml-2">{categoryMeta[cat].label}</span>
        </h4>
        <div class="divide-y divide-base-300/40">
          {byCategory[cat].map((course) => <CourseCard course={course} />)}
        </div>
      </div>
    ))}

    <!-- Custom -->
    <div class="mt-12 p-6 rounded-lg bg-base-200/60 border border-base-300/60">
      <h4 class="text-xl font-bold mb-3">맞춤 강의 · 멘토링</h4>
      <ul class="space-y-2 text-base-content/80 mb-5">
        <li class="flex gap-3"><span class="text-primary">▸</span>기관·기업·대학을 위한 <strong>맞춤형 GIS 워크숍</strong></li>
        <li class="flex gap-3"><span class="text-primary">▸</span>1:1 <strong>온라인 멘토링</strong> (인프런)</li>
        <li class="flex gap-3"><span class="text-primary">▸</span>GIS·공간분석 관련 <strong>컨설팅</strong></li>
      </ul>
      <a href="#contact" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">
        문의하러 가기 →
      </a>
    </div>
  </section>

  <!-- ───────── CV ───────── -->
  <section id="cv" class="scroll-section pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">03. CV</p>
    <h3 class="text-3xl md:text-4xl font-bold mb-8">강사 이력</h3>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">누적 수강생</p>
        <p class="text-xl md:text-2xl font-bold text-primary">{instructorStats.totalStudents.toLocaleString()}<span class="text-sm font-normal text-base-content/60 ml-1">명</span></p>
      </div>
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">평균 평점</p>
        <p class="text-xl md:text-2xl font-bold text-primary">{instructorStats.averageRating}<span class="text-sm font-normal text-base-content/60 ml-1">/5.0</span></p>
      </div>
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">총 강의량</p>
        <p class="text-xl md:text-2xl font-bold text-primary">{totalHours}<span class="text-sm font-normal text-base-content/60 ml-1">h · {totalLectures}강</span></p>
      </div>
      <div class="p-4 rounded-lg bg-base-200/60 border border-base-300/60">
        <p class="font-mono text-xs text-base-content/60 mb-1">수강평</p>
        <p class="text-xl md:text-2xl font-bold text-primary">{instructorStats.totalReviews}<span class="text-sm font-normal text-base-content/60 ml-1">건</span></p>
      </div>
    </div>

    <!-- Education -->
    <h4 class="font-mono text-sm text-primary tracking-wider mb-4">EDUCATION</h4>
    <div class="time-line-container grid gap-4 mb-10">
      <TimeLineElement
        title="박사 과정 수료"
        subtitle="서울대학교 환경대학원 · GIS / Remote Sensing 전공"
      />
      <TimeLineElement
        title="석사 졸업"
        subtitle="서울대학교 환경대학원 · GIS / Remote Sensing 전공"
      />
    </div>

    <!-- Expertise -->
    <h4 class="font-mono text-sm text-primary tracking-wider mb-4">EXPERTISE</h4>
    <div class="time-line-container mb-10">
      <TimeLineElement
        title="GIS · 공간정보 분석"
        subtitle="QGIS · ArcGIS · 공간자료 분석 및 시각화"
      >
        벡터/래스터 자료의 수집·전처리·분석·시각화 전 과정. 공공데이터·위성영상·현장조사 자료의 통합 활용.
      </TimeLineElement>
      <TimeLineElement
        title="원격탐사 (Remote Sensing)"
        subtitle="위성영상 분석 · 식생/토지피복 모니터링"
      >
        Landsat·Sentinel·MODIS 등 위성영상을 활용한 환경 모니터링 연구 경험.
      </TimeLineElement>
      <TimeLineElement
        title="Python × GIS 융합"
        subtitle="GeoPandas · Rasterio · PyQGIS"
      >
        파이썬 기반 공간데이터 처리 자동화. 반복 작업을 코드로 효율화하는 워크플로우 구축.
      </TimeLineElement>
    </div>

    <!-- Skills -->
    <h4 class="font-mono text-sm text-primary tracking-wider mb-4">SKILLS</h4>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <p class="text-sm font-bold mb-2">GIS Software</p>
        <ul class="space-y-1 text-base-content/80 text-sm">
          <li>QGIS</li>
          <li>ArcGIS Pro</li>
          <li>PostGIS</li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold mb-2">Programming</p>
        <ul class="space-y-1 text-base-content/80 text-sm">
          <li>Python (GeoPandas, Rasterio, PyQGIS)</li>
          <li>R (sf, terra)</li>
          <li>SQL · JavaScript</li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold mb-2">Visualization</p>
        <ul class="space-y-1 text-base-content/80 text-sm">
          <li>QGIS Layout</li>
          <li>Leaflet · MapLibre</li>
          <li>Matplotlib · Plotly</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── BLOG (preview) ───────── -->
  <section id="blog" class="scroll-section pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">04. NOTES</p>
    <div class="flex items-end justify-between mb-8">
      <h3 class="text-3xl md:text-4xl font-bold">최근 글</h3>
      <a href="/blog" class="text-sm text-primary hover:underline whitespace-nowrap">전체 보기 →</a>
    </div>

    {
      last_posts.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
          />
          <div class="divider my-0" />
        </>
      ))
    }
  </section>

  <!-- ───────── CONTACT ───────── -->
  <section id="contact" class="scroll-section pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">05. GET IN TOUCH</p>
    <h3 class="text-3xl md:text-4xl font-bold mb-4">함께 일하고 싶으신가요?</h3>
    <p class="text-base-content/70 leading-relaxed mb-8 max-w-xl">
      강의 의뢰, 1:1 멘토링, GIS 컨설팅 등 어떤 형태든 편하게 문의주세요.
      카카오톡 오픈프로필이 가장 빠른 응답 채널입니다.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="https://open.kakao.com/me/upwise" target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2">
        카카오 오픈프로필
      </a>
      <a href="https://www.inflearn.com/users/212773/@upwise" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary gap-2">
        인프런 강사 페이지
      </a>
    </div>
  </section>

  <!-- ───────── Scroll-spy script ───────── -->
  <script is:inline>
    (function () {
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-item');

      if (!sections.length || !navLinks.length) return;

      // Map id → nav link
      const linkById = new Map();
      navLinks.forEach((l) => {
        const href = l.getAttribute('href') || '';
        const id = href.startsWith('#') ? href.slice(1)
                 : href.startsWith('/#') ? href.slice(2)
                 : null;
        if (id) linkById.set(id, l);
      });

      function setActive(id) {
        navLinks.forEach((l) => l.classList.remove('active-nav-item'));
        const link = linkById.get(id);
        if (link) link.classList.add('active-nav-item');
      }

      // Observer: section is "active" when its top crosses the upper 35% of viewport
      const observer = new IntersectionObserver(
        (entries) => {
          // Find the topmost section currently intersecting
          const visible = entries
            .filter((e) => e.isIntersecting)
            .map((e) => e.target);
          if (visible.length === 0) return;

          // Pick the one with the smallest top distance from viewport top
          visible.sort((a, b) =>
            Math.abs(a.getBoundingClientRect().top) - Math.abs(b.getBoundingClientRect().top)
          );
          setActive(visible[0].id);
        },
        { rootMargin: '-35% 0px -55% 0px', threshold: 0 }
      );

      sections.forEach((s) => observer.observe(s));

      // Initial: highlight section in view at load
      const initial = Array.from(sections).find((s) => {
        const r = s.getBoundingClientRect();
        return r.top < window.innerHeight * 0.5 && r.bottom > window.innerHeight * 0.2;
      });
      if (initial) setActive(initial.id);
    })();
  </script>
</BaseLayout>
