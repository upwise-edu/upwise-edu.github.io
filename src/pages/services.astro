---
import BaseLayout from "../layouts/BaseLayout.astro";
import CourseCard from "../components/CourseCard.astro";
import { courses } from "../data/courses";

const byCategory = {
  '입문': courses.filter((c) => c.category === '입문'),
  '시각화': courses.filter((c) => c.category === '시각화'),
  '자동화': courses.filter((c) => c.category === '자동화'),
};

const categoryMeta: Record<string, { label: string; description: string; icon: string }> = {
  '입문': {
    label: 'BEGINNER',
    description: 'QGIS를 처음 만나는 분께. 무료 강의로 가볍게 체험하거나, 올인원 스타터팩으로 한 번에 입문해보세요.',
    icon: '🌱',
  },
  '시각화': {
    label: 'VISUALIZATION',
    description: '발표, 보고서, 콘텐츠용 지도가 필요하신 분께. 공공데이터로 7가지 주제도를 직접 만들어봅니다.',
    icon: '🗺️',
  },
  '자동화': {
    label: 'AUTOMATION',
    description: '반복적인 GIS 작업을 코드로 효율화하고 싶은 분께. QGIS 내장 파이썬 콘솔로 자동화합니다.',
    icon: '⚡',
  },
};
---

<BaseLayout title="강의 안내 | upwise." sideBarActiveItemID="services">
  <section class="pb-12 pt-8 animate-fade-up">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">COURSES</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-4">강의 안내</h1>
    <p class="text-base-content/70 leading-relaxed max-w-2xl">
      QGIS를 단계별로 익힐 수 있도록 강의를 <strong>입문 → 시각화 → 자동화</strong> 순서로 구성했습니다.
      지금 본인에게 필요한 트랙부터 시작하세요.
    </p>
  </section>

  <!-- Roadmap visual -->
  <section class="pb-12 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">LEARNING ROADMAP</p>
    <h2 class="text-2xl font-bold mb-6">학습 로드맵</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {(['입문', '시각화', '자동화'] as const).map((cat, idx) => (
        <div class="relative p-5 rounded-lg bg-base-200/60 border border-base-300/60">
          <div class="text-2xl mb-2">{categoryMeta[cat].icon}</div>
          <p class="font-mono text-xs text-primary tracking-wider mb-1">
            STEP {idx + 1}
          </p>
          <h3 class="font-bold text-lg mb-2">{cat}</h3>
          <p class="text-sm text-base-content/70 leading-relaxed">
            {categoryMeta[cat].description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Courses by category -->
  {(['입문', '시각화', '자동화'] as const).map((cat) => (
    <section class="pb-12 border-t border-base-300 pt-10">
      <p class="font-mono text-sm text-primary tracking-wider mb-3">
        {categoryMeta[cat].label}
      </p>
      <h2 class="text-2xl md:text-3xl font-bold mb-2">
        <span class="mr-2">{categoryMeta[cat].icon}</span>{cat}
      </h2>
      <p class="text-base-content/70 mb-6 max-w-2xl">
        {categoryMeta[cat].description}
      </p>

      <div class="divide-y divide-base-300/40">
        {byCategory[cat].map((course) => <CourseCard course={course} />)}
      </div>
    </section>
  ))}

  <!-- Custom/Offline -->
  <section class="pb-16 border-t border-base-300 pt-10">
    <p class="font-mono text-sm text-primary tracking-wider mb-3">CUSTOM</p>
    <h2 class="text-2xl md:text-3xl font-bold mb-4">맞춤 강의 · 멘토링</h2>
    <p class="text-base-content/70 leading-relaxed max-w-2xl mb-6">
      온라인 강의 외에도 다음과 같은 형태로 함께 일할 수 있습니다:
    </p>
    <ul class="space-y-2 text-base-content/80 mb-8 max-w-2xl">
      <li class="flex gap-3"><span class="text-primary">▸</span>기관·기업·대학을 위한 <strong>맞춤형 GIS 워크숍</strong></li>
      <li class="flex gap-3"><span class="text-primary">▸</span>1:1 <strong>온라인 멘토링</strong> (인프런 멘토링)</li>
      <li class="flex gap-3"><span class="text-primary">▸</span>GIS·공간분석 관련 <strong>컨설팅</strong></li>
    </ul>
    <div class="flex flex-wrap gap-3">
      <a href="https://open.kakao.com/me/upwise" target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2">
        카카오로 문의
      </a>
      <a href="https://www.inflearn.com/users/212773/@upwise" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary gap-2">
        인프런 멘토링
      </a>
    </div>
  </section>
</BaseLayout>
