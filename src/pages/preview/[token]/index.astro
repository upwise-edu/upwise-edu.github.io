---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { fmtDate, postSlug } from "../../../lib/blog";

export async function getStaticPaths() {
  const token = import.meta.env.PREVIEW_TOKEN;
  if (!token) return [];
  return [{ params: { token } }];
}

const { token } = Astro.params;
const posts = (await getCollection("blog", ({ id }) => id.startsWith("ko/"))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  lang="ko"
  title="초안 미리보기 | UPWISE"
  description="비공개 초안 미리보기"
  noindex={true}
>
  <section class="pt-10 pb-16 animate-fade-up max-w-2xl">
    <div class="mb-8 rounded-xl border-2 border-warning bg-warning/15 px-4 py-3">
      <p class="type-body font-bold text-base-content">
        비공개 미리보기 — 이 주소를 공유하지 마세요
      </p>
      <p class="type-body-sm text-base-content/70 mt-1">
        발행 전 초안을 포함한 전체 목록입니다. 검색엔진 색인에서 제외됩니다.
      </p>
    </div>

    <h1 class="type-display-lg text-base-content mb-6">초안 미리보기</h1>

    <ul class="flex flex-col gap-1">
      {posts.map((post) => (
        <li class="py-3 border-b border-base-content/10">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <span class="text-[11px] px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20">
              {post.data.category}
            </span>
            <span class="type-body-sm text-base-content/55">{fmtDate(post.data.date)}</span>
            {post.data.draft && (
              <span class="text-[11px] px-2 py-0.5 rounded bg-warning/20 text-warning-content border border-warning/50 font-bold">
                초안
              </span>
            )}
          </div>
          <a
            href={`/preview/${token}/${postSlug(post)}/`}
            class="type-body text-base-content hover:text-primary hover:underline"
          >
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p class="type-body text-base-content/55">글이 없습니다.</p>
    )}
  </section>
</BaseLayout>
