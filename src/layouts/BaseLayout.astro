---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  includeStructuredData = false,
  lang = "ko",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} includeStructuredData={includeStructuredData} lang={lang} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <!-- Animated topographic contour background (Canvas + simplex noise) -->
    <canvas id="topo-canvas" aria-hidden="true"></canvas>

    <div class="drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" aria-label="메뉴 열기/닫기" />
      <div class="drawer-content">
        <Header lang={lang} />
        <div class="md:flex md:justify-center">
          <main class="p-5 sm:p-6 pt-10 lg:max-w-[900px] w-full max-w-full">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} lang={lang} />}
    </div>

    <!-- Cursor spotlight tracker (desktop only, fine pointer) -->
    <script>
      if (window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches) {
        document.addEventListener('mousemove', (e) => {
          document.body.style.setProperty('--cursor-x', e.clientX + 'px');
          document.body.style.setProperty('--cursor-y', e.clientY + 'px');
        });
      }
    </script>

    <!-- Animated topographic background — simplex noise + marching squares -->
    <script>
      import { createNoise3D } from 'simplex-noise';

      const canvas = document.getElementById('topo-canvas') as HTMLCanvasElement | null;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const noise3D = createNoise3D();

          // Smoother contours on desktop (higher grid), much lighter on touch (perf + visibility)
          // Multi-signal detection: hover/pointer media queries can lie on some mobile browsers,
          // so also fall back to viewport width matching the Tailwind `lg:` breakpoint (1024px).
          const isTouch =
            window.matchMedia('(hover: none)').matches ||
            window.matchMedia('(pointer: coarse)').matches ||
            window.innerWidth < 1024;

          const COLS = isTouch ? 65 : 90;   // mobile: denser grid for smoother contours (less angular)
          const ROWS = isTouch ? 45 : 60;
          const LEVELS = isTouch ? 6 : 12;
          const ACCENT_A = 3;  // orange line index
          const ACCENT_B = 8;  // navy / soft-orange accent line index

          // Touch: extremely subtle (very low alpha + hair-thin lines) + frame rate cap
          const opacityMult = isTouch ? 0.8 : 1;      // mobile lines = 80% of desktop alpha (CSS mask attenuates further)
          const lineWidthMult = isTouch ? 0.4 : 1;    // mobile lines = 0.4x desktop thickness
          const targetFPS = isTouch ? 24 : 60;
          const frameInterval = 1000 / targetFPS;
          let lastFrameTime = 0;

          // 성능: 모션 민감 사용자 존중 + 탭이 가려지면 애니메이션 일시정지(CPU 절약)
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let running = false;
          function schedule() {
            if (document.hidden || reduceMotion) { running = false; return; }
            running = true;
            requestAnimationFrame(frame);
          }

          // Animation pacing — noticeable idle flow, scroll boosts directly to max 2x
          const IDLE_VEL = 0.00005;       // base flow per ms — needs to be loud enough that 2x is visible

          let W = 0, H = 0, dpr = 1;
          function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            W = Math.floor(window.innerWidth * dpr);
            H = Math.floor(window.innerHeight * dpr);
            canvas!.width = W;
            canvas!.height = H;
            canvas!.style.width = window.innerWidth + 'px';
            canvas!.style.height = window.innerHeight + 'px';
          }
          window.addEventListener('resize', resize);
          resize();

          // Cursor (smoothed) + scroll delta (read directly per frame, no smoothing)
          let targetMx = 0.5, targetMy = 0.5, mx = 0.5, my = 0.5;
          let lastScrollY = window.scrollY;
          window.addEventListener('mousemove', (e) => {
            targetMx = e.clientX / window.innerWidth;
            targetMy = e.clientY / window.innerHeight;
          }, { passive: true });

          function themeColors() {
            const dark = document.documentElement.getAttribute('data-theme') === 'upwise-dark';
            const m = opacityMult;
            return {
              base:   dark ? `rgba(226, 232, 240, ${0.18 * m})` : `rgba(30, 58, 95, ${0.22 * m})`,
              orange: dark ? `rgba(247, 147, 30, ${0.75 * m})`  : `rgba(247, 147, 30, ${0.65 * m})`,
              accent2:dark ? `rgba(255, 167, 86, ${0.55 * m})`  : `rgba(30, 58, 95, ${0.7 * m})`,
            };
          }

          // Round line endings/joins to soften the polygonal feel
          ctx.lineJoin = 'round';
          ctx.lineCap = 'round';

          // Marching squares — draw isoline for a single threshold
          function drawIsoline(grid: Float32Array, gw: number, gh: number, threshold: number, cellW: number, cellH: number) {
            ctx!.beginPath();
            for (let y = 0; y < gh - 1; y++) {
              for (let x = 0; x < gw - 1; x++) {
                const i = y * gw + x;
                const tl = grid[i];
                const tr = grid[i + 1];
                const br = grid[i + gw + 1];
                const bl = grid[i + gw];
                let m = 0;
                if (tl > threshold) m |= 1;
                if (tr > threshold) m |= 2;
                if (br > threshold) m |= 4;
                if (bl > threshold) m |= 8;
                if (m === 0 || m === 15) continue;

                const px = x * cellW;
                const py = y * cellH;
                const iTop    = px + cellW * ((threshold - tl) / (tr - tl));
                const iRight  = py + cellH * ((threshold - tr) / (br - tr));
                const iBottom = px + cellW * ((threshold - bl) / (br - bl));
                const iLeft   = py + cellH * ((threshold - tl) / (bl - tl));

                switch (m) {
                  case 1: case 14:
                    ctx!.moveTo(px, iLeft); ctx!.lineTo(iTop, py); break;
                  case 2: case 13:
                    ctx!.moveTo(iTop, py); ctx!.lineTo(px + cellW, iRight); break;
                  case 3: case 12:
                    ctx!.moveTo(px, iLeft); ctx!.lineTo(px + cellW, iRight); break;
                  case 4: case 11:
                    ctx!.moveTo(px + cellW, iRight); ctx!.lineTo(iBottom, py + cellH); break;
                  case 6: case 9:
                    ctx!.moveTo(iTop, py); ctx!.lineTo(iBottom, py + cellH); break;
                  case 7: case 8:
                    ctx!.moveTo(px, iLeft); ctx!.lineTo(iBottom, py + cellH); break;
                  case 5:
                    ctx!.moveTo(px, iLeft); ctx!.lineTo(iTop, py);
                    ctx!.moveTo(px + cellW, iRight); ctx!.lineTo(iBottom, py + cellH); break;
                  case 10:
                    ctx!.moveTo(iTop, py); ctx!.lineTo(px + cellW, iRight);
                    ctx!.moveTo(px, iLeft); ctx!.lineTo(iBottom, py + cellH); break;
                }
              }
            }
            ctx!.stroke();
          }

          const start = performance.now();
          let zCurrent = 0;
          function frame(now: number) {
            // Frame-rate cap (lower FPS on touch to reduce lag)
            if (now - lastFrameTime < frameInterval) {
              schedule();
              return;
            }
            const dt = (now - lastFrameTime) || 16;
            lastFrameTime = now;

            // Ease cursor
            mx += (targetMx - mx) * 0.06;
            my += (targetMy - my) * 0.06;

            // Direct scroll-to-z integration (no smoothing → instant feedback).
            // Scroll always advances z FORWARD regardless of direction (no rewind on scroll-up).
            // Per-frame contribution capped at idleStep × 4 → total motion within 5x cap.
            const curScrollY = window.scrollY;
            const scrollDelta = Math.abs(curScrollY - lastScrollY);
            lastScrollY = curScrollY;

            const idleStep   = IDLE_VEL * dt;
            const scrollStep = Math.min(scrollDelta * 0.00016, idleStep * 4);

            zCurrent += idleStep + scrollStep;

            const cursorOffX = (mx - 0.5) * 0.5;
            const cursorOffY = (my - 0.5) * 0.5;
            const z = zCurrent;

            const gw = COLS + 1;
            const gh = ROWS + 1;
            const cellW = W / COLS;
            const cellH = H / ROWS;

            const grid = new Float32Array(gw * gh);
            for (let y = 0; y < gh; y++) {
              for (let x = 0; x < gw; x++) {
                const nx = (x / COLS) * 2.4 + cursorOffX;
                const ny = (y / ROWS) * 1.8 + cursorOffY;
                grid[y * gw + x] = noise3D(nx, ny, z);
              }
            }

            ctx!.clearRect(0, 0, W, H);
            const c = themeColors();
            for (let i = 0; i < LEVELS; i++) {
              const threshold = -0.7 + (1.4 / (LEVELS - 1)) * i;
              if (i === ACCENT_A) {
                ctx!.strokeStyle = c.orange;
                ctx!.lineWidth = 1.6 * dpr * lineWidthMult;
              } else if (i === ACCENT_B) {
                ctx!.strokeStyle = c.accent2;
                ctx!.lineWidth = 0.8 * dpr * lineWidthMult;
              } else {
                ctx!.strokeStyle = c.base;
                ctx!.lineWidth = 1 * dpr * lineWidthMult;
              }
              drawIsoline(grid, gw, gh, threshold, cellW, cellH);
            }

            schedule();
          }

          // 탭 가시성 변화 시 일시정지/재개 (재개 시 dt 폭주 방지)
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden && !running && !reduceMotion) {
              lastFrameTime = performance.now();
              schedule();
            }
          });

          // 성능: 첫 화면(LCP)이 그려진 뒤 idle 시점에 애니메이션 시작.
          // 배경 노이즈 계산이 초기 렌더의 메인 스레드를 막지 않도록 지연 → 저속 기기 LCP/TBT 개선.
          function begin() {
            if (reduceMotion) {
              frame(performance.now()); // 정적 1프레임만
            } else {
              lastFrameTime = performance.now();
              schedule();
            }
          }
          function deferBegin() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(begin, { timeout: 1500 });
            } else {
              setTimeout(begin, 300);
            }
          }
          if (document.readyState === 'complete') {
            deferBegin();
          } else {
            window.addEventListener('load', deferBegin, { once: true });
          }
        }
      }
    </script>
  </body>
</html>
